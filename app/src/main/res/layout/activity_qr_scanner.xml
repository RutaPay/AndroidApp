<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rp_black">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_scanner_layout="@layout/zxing_scanner_overlay" />

    <!-- Degradado superior para que el encabezado se lea sobre la cámara -->
    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_qr_top_scrim" />

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/qr_close_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_qr_circle_button"
            android:contentDescription="Cerrar escáner"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_qr_close" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lexend_bold"
                android:text="Escanear código"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lexend_regular"
                android:text="Apunta al QR del validador del autobús"
                android:textColor="#B8C7D6"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hoja inferior con instrucciones y linterna -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_qr_bottom_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_bold"
            android:text="Coloca el código dentro del marco"
            android:textColor="@color/rp_navy"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lexend_regular"
            android:lineSpacingExtra="2dp"
            android:text="El QR está en la pantalla del validador y cambia en cada viaje. No compartas tu código con nadie."
            android:textColor="@color/rp_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/qr_torch_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_qr_torch_off"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/qr_torch_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Linterna"
                android:src="@drawable/ic_qr_flash" />

            <TextView
                android:id="@+id/qr_torch_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/lexend_semibold"
                android:text="Encender linterna"
                android:textColor="@color/rp_navy"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
